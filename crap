    def p2thta_refactored(self, tpres, plevs, tsfc, psfc, **kwargs):
        """
        Production-grade potential temperature driver pipeline.
        Enforces 1e-16 MAE by routing arrays to the parity-validated grid generator.
        Constants and solver configurations are injected automatically via kwargs.
        """
        import numpy as np

        module_path = kwargs['STRATEGY_MODULE']
        class_path = kwargs['STRATEGY_CLASS']
        
        # Pull parameters dynamically injected from config.yaml solver_settings
        dthta = float(kwargs.get('DTHTA', 10.0))
        maxlvl = int(kwargs.get('MAXLVL', 50))
        
        # Enforce pure float64 processing arrays
        tsfc = np.asarray(tsfc, dtype=np.float64)
        psfc = np.asarray(psfc, dtype=np.float64)
        tpres = np.asarray(tpres, dtype=np.float64)
        plevs = np.asarray(plevs, dtype=np.float64)
        
        plvls = len(plevs)
        latLen, lonLen = psfc.shape  # Resolves cleanly to (73, 144)
        
        # --- PHASE 1: STABILIZE ATMOSPHERIC TEMPERATURES ---
        potsfc = self.pot(tsfc, psfc)
        thtap = self.pot(tpres, plevs)
        thtalo = np.min(potsfc)
        
        super_adiabatic_engine = DynamicStrategyFactory.resolve(module_path, class_path)
        thtap_cleaned, thtahi = super_adiabatic_engine.execute(psfc, plevs, potsfc, thtap, **kwargs)
        
        # --- PHASE 2: EXECUTE PARITY-VALIDATED GRID GENERATOR ---
        # Replaces the legacy generator with the exact thesis boundary replica
        thta_grid_padded, kthta = self.generate_theta_levels_exact(
            lonLen, latLen, plvls, potsfc, thtap_cleaned, thtalo, thtahi, dthta, maxlvl
        )
        
        # Slice out the trailing zero padding to pass a clean vector downstream
        thta_grid_clean = thta_grid_padded[:kthta]

        # --- PHASE 3: UNPACK SOLVER VARIABLES FROM DECORATOR ---
        kappa = kwargs["KAPPA"]
        p0_val = kwargs["P0"]
        epsln = kwargs["EPSLN"]
        nmax = kwargs["NMAX"]
        missing_val = kwargs["MISSING_DATA"]

        # Establish execution shapes: (KOUT, NJ, NI) using polished variable hooks
        # tpres shape is (17, 73, 144) -> squeeze gives (PLVLS, NJ, NI)
        t_arr = np.squeeze(tpres)     
        plvls, nj, ni = t_arr.shape
        kout = int(kthta)
        
        pres = np.asarray(plevs, dtype=np.float64)  
        log_plevs = np.log(pres)
        log_p0 = log_plevs  # Fixed index vector matching Fortran's ALOGP(1)

        # Re-compute background structures on the polished inputs
        potsfc = self.pot(tsfc, psfc)
        thtap  = self.pot(t_arr, pres)
        
        pt_out = np.full((kout, nj, ni), missing_val, dtype=np.float64)
        done = np.zeros((kout, nj, ni), dtype=bool)

        # Broadcast spatial matrices to full 3D coordinates using thta_grid_clean
        potsfc_3d = np.broadcast_to(potsfc[None, :, :], (kout, nj, ni))
        psfc_3d   = np.broadcast_to(psfc[None, :, :], (kout, nj, ni))
        thta_3d   = np.broadcast_to(thta_grid_clean[:, None, None], (kout, nj, ni))
        thtap_top = np.broadcast_to(thtap[-1, None, :, :], (kout, nj, ni))

        # =====================================================================
        # INITIALIZATION SHORTCUTS: CONDITIONS 1, 2, AND 3
        # =====================================================================
        # Condition 1: Theta level is below surface
        pt_out[thta_3d < potsfc_3d] = missing_val
        done[thta_3d < potsfc_3d] = True

        # Condition 2: Theta level is above top pressure level
        pt_out[thta_3d > thtap_top] = missing_val
        done[thta_3d > thtap_top] = True

        # Condition 3: Theta level at the surface
        mask_sfc = (~done) & (np.abs(thta_3d - potsfc_3d) < 0.001)
        pt_out[mask_sfc] = psfc_3d[mask_sfc]
        done[mask_sfc] = True

        # =====================================================================
        # VERTICAL ISOBARIC COLUMN STRATIFIED SEARCH PROFILE SCANNER
        # =====================================================================
        for k in range(plvls):
            thtap_k = np.broadcast_to(thtap[k, None, :, :], (kout, nj, ni))
            
            # Replicates the core 1700 CONTINUE loop search trigger
            active = (~done) & (thta_3d < thtap_k)
            if not np.any(active): 
                continue

            # Call Sub-Method 2: Resolve the remaining 3 bracketing boundary layers
            potdwn, pdwn, alogpd, potup, pup, alogpu = self._determine_vertical_bracketing_layer(
                k, active, potsfc_3d, psfc_3d, thta_3d, thtap, pres, log_plevs, plvls, kout, nj, ni
            )

            # Call Sub-Method 3: Run the analytical Newton-Raphson optimization
            pt_layer = self._solve_isentropic_pressure_nr(
                active, thta_3d, potdwn, pdwn, alogpd, potup, pup, alogpu, log_p0, kappa, epsln, nmax, p0_val
            )
            
            # Commit solved pressures and mark spatial nodes as complete
            pt_out[active] = pt_layer[active]
            done[active] = True
            
        # =====================================================================
        # POST-PROCESSING: VERTICAL PRESSURE MONOTONICITY ENFORCEMENT
        # =====================================================================
        # Shifted completely OUTSDE the vertical plvls search block to prevent shadowing
        for kout_idx in range(1, kout):
            # Condition: Prior level pressure must be valid (greater than 0, not missing_val)
            valid_prev = pt_out[kout_idx - 1] > 0
            
            # Violation: Pressure increases as potential temperature increases
            violation = valid_prev & (pt_out[kout_idx] > pt_out[kout_idx - 1])
            
            # Clamp violation to prior level pressure + 0.001
            pt_out[kout_idx] = np.where(violation, pt_out[kout_idx - 1] + 0.001, pt_out[kout_idx])

        return pt_out

